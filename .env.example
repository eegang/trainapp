# Токен бота от @BotFather:  /newbot  ->  скопируйте значение
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Telegram user_id тех, кому бот отвечает (через запятую). Получить: @userinfobot
ALLOWED_USER_IDS=123456789

# Путь к базе данных (необязательно, по умолчанию ./training_bot.db)
# DB_PATH=./training_bot.db

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
